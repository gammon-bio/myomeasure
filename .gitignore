# ============================================================================
# MyoMeasure -- .gitignore
#
# This repository ships CODE ONLY: the measurement pipeline, the analysis and
# figure scripts behind the published numbers, and the reproducibility
# container. Measurement data lives in the Zenodo deposit; figures, tables,
# legends and manuscript files are not distributed here. See the README
# sections "What this repository contains" and "Data availability".
# ============================================================================

# --- OS / editor / scratch ---
.DS_Store
~$*
.Rhistory
**/.Rhistory
__pycache__/
*.pyc
*.bak
*.bak_*
.pytest_cache/
**/.pytest_cache/

# --- Environments, archives, vendored deps ---
archive/
**/venv/
**/node_modules/

# --- Office documents are never committed (manuscripts, decks, worksheets) ---
*.docx
*.pptx
*.xlsx

# --- Reference-manager libraries ---
*.enl
*.Data/

# --- Raw microscopy data -> Zenodo deposit ---
*.vsi
/data/

# --- Inference outputs and QC artifacts (regenerable) ---
**/*_measurement_overlay.png
**/*_cp_masks.tif
**/processing.log

# --- results/: ignore every output tree; keep only the analysis script that
#     lives alongside the dexamethasone data. Negating the directory is what
#     lets git descend into it to re-admit the script.
/results/*
!/results/IGF_dexa_combined/
/results/IGF_dexa_combined/*
!/results/IGF_dexa_combined/make_figures.py

# --- Manuscript outputs and internal notes: not part of the public release ---
/reports/
/audit/
/NUMBERS_CHANGED.md
/PROSE_UPDATES_*.md
/RELEASE_MANIFEST.md
/check_figure_typography.py

# --- scripts/: ship the paper analysis scripts and the Zenodo stager ---
/scripts/*
!/scripts/paper_scripts_final/
!/scripts/stage_zenodo_data.sh

# --- Build, scan and staging outputs ---
/zenodo_data/
/scout.json
/scout_all.json
